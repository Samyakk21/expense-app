# Copy this file to `.env` for local development and fill in your Supabase values.
# On Vercel, add these same variables in Project Settings → Environment Variables.

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Use the SERVICE ROLE key (server-side only) so the backend can read/write
# regardless of Row Level Security. Alternatively use the anon key together with
# the permissive demo policies in supabase/schema.sql.
SUPABASE_KEY=
